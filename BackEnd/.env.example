# Copy to .env for Docker Compose, then supply your own values.
# Spring Boot run from the IDE reads process environment variables, not this file.
MYSQL_ROOT_PASSWORD=
DB_USERNAME=dat_san_app
DB_PASSWORD=
# Base64 of at least 64 random bytes. See ../HUONG_DAN_CHAY.md.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
